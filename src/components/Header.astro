---
import { NAV_LINKS, SITE_TITLE } from '../data/site';
import { languages, localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  translations: Partial<Record<Lang, string>>;
}

const { lang, translations } = Astro.props;
const t = useTranslations(lang);
const otherLangs = (Object.keys(translations) as Lang[]).filter((l) => l !== lang);
---

<header class='flex flex-wrap items-center justify-between gap-x-4'>
  <a href={localizePath(lang, '/')} class='py-2 font-bold'>{SITE_TITLE}</a>
  <nav class='flex gap-4'>
    {
      NAV_LINKS.map(({ key, path }) => (
        <a href={localizePath(lang, path)} class='py-2 underline'>
          {t(key)}
        </a>
      ))
    }
    {
      otherLangs.map((l) => (
        <a href={translations[l]} hreflang={l} lang={l} class='py-2 underline'>
          {languages[l]}
        </a>
      ))
    }
  </nav>
</header>
