---
import { AUTHOR, SOCIAL_LINKS } from '../data/site';

const year = new Date().getFullYear();
---

<footer class='flex flex-col-reverse gap-2 text-sm sm:flex-row sm:items-center sm:justify-between'>
  <p>&copy; {year} {AUTHOR}</p>
  <ul class='flex flex-wrap gap-x-4'>
    {
      SOCIAL_LINKS.map(({ label, href }) => (
        <li>
          <a href={href} target='_blank' rel='noopener noreferrer' class='inline-block py-2 underline'>
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</footer>
