---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../data/site';
import { langs, localizePath, stripLang, toLang, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** This page's URL in each language. Defaults to the same path under every locale. */
  translations?: Partial<Record<Lang, string>>;
}

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const {
  title,
  description = t('site.description'),
  translations = Object.fromEntries(
    langs.map((l) => [l, localizePath(l, stripLang(Astro.url.pathname))]),
  ),
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <link
      rel='alternate'
      type='application/rss+xml'
      title={SITE_TITLE}
      href={new URL(localizePath(lang, '/rss.xml'), Astro.site)}
    />
    <link rel='canonical' href={canonicalURL} />
    {
      Object.entries(translations).map(([l, href]) => (
        <link rel='alternate' hreflang={l} href={new URL(href, Astro.site)} />
      ))
    }
    <title>{pageTitle}</title>
    <meta name='description' content={description} />
    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonicalURL} />
    <meta property='og:title' content={pageTitle} />
    <meta property='og:description' content={description} />
    <meta property='og:locale' content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
  </head>
  <body class='mx-auto flex min-h-svh max-w-2xl flex-col gap-12 px-4 py-8'>
    <Header lang={lang} translations={translations} />
    <main class='flex-1'>
      <slot />
    </main>
    <Footer />
  </body>
</html>
